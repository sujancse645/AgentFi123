# ---- VERCEL / SERVERLESS ENVIRONMENT VARIABLES ----

# Database Connection (Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Server / Auth
JWT_SECRET=your_super_secret_jwt_key
NODE_ENV=development

# Solana Configuration
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# AI Settings (Optional - falls back to deterministic mock if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=your_openai_api_key

# ---- FRONTEND ENVIRONMENT VARIABLES ----
# Note: For Vercel, VITE_API_BASE_URL should ideally be relative (e.g. /api)
# For local development with Vite + Express concurrently, use http://localhost:5000/api
VITE_API_BASE_URL=/api
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_DEMO_FALLBACK=true
